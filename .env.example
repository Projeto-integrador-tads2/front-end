# Exemplo de variáveis de ambiente para Tantto Web
# Preencha os valores conforme sua configuração local ou de produção

# Porta padrão do servidor
PORT=3000 # int, porta onde o serviço escuta

# URL do banco de dados
DATABASE_URL= # string, obrigatório, conexão com banco

# Chave secreta para autenticação
NEXTAUTH_SECRET= # string, obrigatório, usada pelo NextAuth

# URL base do frontend
NEXT_PUBLIC_BASE_URL=http://localhost:3000 # string, opcional, URL do frontend

# Outras variáveis detectadas podem ser adicionadas conforme necessidade

